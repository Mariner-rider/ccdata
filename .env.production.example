# ─── CollegeCue Production Environment ───────────────
# Copy to .env and fill every CHANGE_ME value.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ── Object Storage (MinIO) ────────────────────────────
MINIO_ROOT_USER=collegecue_admin
# Generate: openssl rand -hex 24
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── API Security ──────────────────────────────────────
# Generate: openssl rand -hex 32
SERVICE_API_KEY=CHANGE_ME

# ── Airflow ───────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME

# ── Crawl Settings ────────────────────────────────────
CRAWL_MAX_PAGES_PER_SOURCE=40
CRAWL_MAX_DEPTH=3
CRAWL_RATE_LIMIT_SECONDS=1.5
CRAWL_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE_SECONDS=2
DAILY_MAX_JOBS=500
DAILY_MAX_JOBS_PER_DOMAIN=20

# ── Scheduling ────────────────────────────────────────
FRESHNESS_DAYS_THRESHOLD=30
FRESHNESS_SCAN_INTERVAL_SECONDS=300

# ── Proxy (optional — leave blank to disable) ─────────
HTTP_PROXY_LIST=

# ── Feature flags ─────────────────────────────────────
LOG_FORMAT=json
DEBUG_RAW_HTML=false
RAW_HTML_RETENTION_DAYS=7
API_RATE_LIMIT_PER_MINUTE=120
